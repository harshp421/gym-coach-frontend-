# ============================================================================
# Gym Coach — frontend env. Copy to `.env` and fill in. Never commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------

# Base URL of the backend API. MUST match the backend's PORT (default 3000).
# In production, point this at your deployed backend (https://api.your.app/api/v1).
VITE_API_URL=http://localhost:3000/api/v1

# --- OPTIONAL ---------------------------------------------------------------

# Google sign-in. Same client_id as the backend's GOOGLE_CLIENT_ID — the
# (client_id, origin) pair must be registered under "Authorized JavaScript
# origins" in Google Cloud Console. Missing → the "Continue with Google"
# button stays hidden.
VITE_GOOGLE_CLIENT_ID=

# Cloudinary — photo upload for the AI coach (e.g. "what machine is this?").
# Missing → the camera button in the coach composer stays disabled.
#
# Setup at https://cloudinary.com:
#   1. Create a free account; cloud name is on your dashboard.
#   2. Settings → Upload → Add upload preset. Set "Signing Mode" to
#      "Unsigned" and copy the preset name.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
